# ──────────────────────────────────────────────────────────────────────────
# Adilade environment
# Copy to .env for local development. Never commit .env.
# "Active since" tells you which MVP milestone starts reading the variable.
# ──────────────────────────────────────────────────────────────────────────

# ─── Warehouse (the database your questions run against) ── active: step 2 ─
# The Wren engine connects here (read-only queries only; the engine's policy
# layer rejects anything but SELECTs). With Docker Compose this defaults to
# the bundled sample warehouse; point it at your real Postgres to go live.
WAREHOUSE_DATABASE_URL=postgres://adilade:adilade_local_dev@sample-warehouse:5432/adilade_sample

# Password for the bundled sample warehouse container (local dev only).
# Compose folds it into the default WAREHOUSE_DATABASE_URL automatically;
# only mirror it manually if you write your own URL. Postgres reads it on
# FIRST boot of an empty volume only — after changing it, run
# `docker compose down -v` (destroys the sample data) to re-initialize.
SAMPLE_WAREHOUSE_PASSWORD=adilade_local_dev

# ─── LLM (bring your own key) ─────────────────────────── active: step 3 ──
# Anthropic Claude is the default provider. The key is only used by the
# Adilade orchestrator (web service); the engine itself never calls an LLM.
ANTHROPIC_API_KEY=
ADILADE_LLM_MODEL=claude-sonnet-5

# ─── Adilade app ──────────────────────────────────────── active: step 3 ──
# Single-user password gate for the web UI. Set something long and random.
ADILADE_PASSWORD=change-me

# Where the web app reaches the engine's MCP endpoint. In Docker Compose /
# Railway private networking this is the internal service address. The MCP
# server has no auth of its own — never expose it publicly.
ENGINE_MCP_URL=http://engine:8080/mcp

# ─── App state (saved questions) ──────────────────────── active: step 4 ──
# Adilade's own small database (NOT your warehouse).
APP_DATABASE_URL=postgres://adilade:change-me@app-db:5432/adilade_app
